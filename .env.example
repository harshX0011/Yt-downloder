# Copy to .env and fill in what you need. Every value here has a safe default,
# so the app boots with none of them set.

# --- official YouTube metadata -------------------------------------------------
# Optional. Without it the app uses YouTube's public oEmbed endpoint, which
# returns title, channel and thumbnail but no duration.
# Get one at https://console.cloud.google.com/apis/credentials and enable
# "YouTube Data API v3" for the project. Never commit the key.
YOUTUBE_API_KEY=

# --- source policy -------------------------------------------------------------
# yt-dlp extractor keys allowed to produce a file download. Add to this list only
# if you have satisfied yourself that the source publishes its media openly.
ALLOWED_EXTRACTORS=ArchiveOrg,Wikimedia,PeerTube,CCC
# Allow links that point straight at a media file (https://example.org/talk.mp4).
ALLOW_DIRECT_MEDIA_URLS=true

# --- limits --------------------------------------------------------------------
MAX_DOWNLOAD_BYTES=1073741824
MAX_DURATION_SECONDS=14400
MAX_CONCURRENT_DOWNLOADS=2
JOB_TTL_SECONDS=1800
REQUEST_TIMEOUT_SECONDS=20

# --- rate limiting (per client IP) ---------------------------------------------
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- server --------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DOWNLOAD_DIR=
# Comma-separated origins for browser clients on another domain. Empty disables CORS.
CORS_ORIGINS=
# Set to true only when running behind a proxy you control, so that X-Forwarded-For
# can be trusted for rate limiting.
TRUST_FORWARDED_FOR=false

# --- networking ----------------------------------------------------------------
# Ports the app is willing to fetch from.
ALLOWED_PORTS=80,443
# Leave false in production. Turning it on disables the SSRF guard and lets the
# app reach private and loopback addresses, which is only useful for local testing.
ALLOW_PRIVATE_ADDRESSES=false
